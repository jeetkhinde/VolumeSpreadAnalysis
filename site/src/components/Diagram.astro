---
/**
 * Original explanatory diagrams — not from the book.
 * Inline SVG so they stay crisp, theme-aware and weightless.
 */
interface Props { name: string }
const { name } = Astro.props;

const TITLES: Record<string, string> = {
  'bar-anatomy': 'How to read one price bar',
  'signals': 'The four bar signatures, side by side',
  'effort-result': 'Effort versus result',
  'cycle': 'The four phases of a market cycle',
};
---

<figure class="dgm">
  <div class="dgm__box">
    {name === 'bar-anatomy' && (
      <svg viewBox="0 0 640 280" role="img" aria-label="Anatomy of a price bar: high, low, close and spread, plus the three closing positions">
        <g class="ink">
          <text x="0" y="14" class="cap">A SINGLE BAR</text>
          <line x1="90" y1="60" x2="90" y2="210" class="bar" />
          <line x1="90" y1="130" x2="112" y2="130" class="bar" />
          <line x1="68" y1="60" x2="90" y2="60" class="tick" />
          <line x1="68" y1="210" x2="90" y2="210" class="tick" />
          <text x="120" y="64" class="lbl">High</text>
          <text x="120" y="134" class="lbl">Close</text>
          <text x="120" y="214" class="lbl">Low</text>
          <path d="M42 60 L30 60 L30 210 L42 210" class="brace" />
          <text x="0" y="139" class="lbl">Spread</text>

          <text x="250" y="14" class="cap">WHERE IT CLOSES DECIDES THE MEANING</text>
          <g transform="translate(280,0)">
            <line x1="0" y1="60" x2="0" y2="210" class="bar" />
            <line x1="0" y1="76" x2="20" y2="76" class="bar up" />
            <text x="-26" y="238" class="lbl sm">Close high</text>
            <text x="-20" y="256" class="lbl sm strong">strength</text>
          </g>
          <g transform="translate(400,0)">
            <line x1="0" y1="60" x2="0" y2="210" class="bar" />
            <line x1="0" y1="135" x2="20" y2="135" class="bar" />
            <text x="-30" y="238" class="lbl sm">Close middle</text>
            <text x="-22" y="256" class="lbl sm">neutral</text>
          </g>
          <g transform="translate(520,0)">
            <line x1="0" y1="60" x2="0" y2="210" class="bar" />
            <line x1="0" y1="194" x2="20" y2="194" class="bar down" />
            <text x="-24" y="238" class="lbl sm">Close low</text>
            <text x="-22" y="256" class="lbl sm weak">weakness</text>
          </g>
        </g>
      </svg>
    )}

    {name === 'signals' && (
      <svg viewBox="0 0 640 300" role="img" aria-label="Four bar signatures: no demand, test, up-thrust and stopping volume, each showing spread, close and volume">
        <g class="ink">
          {[
            { x: 0, t: 'No demand', v: 22, hi: 96, lo: 132, close: 100, cd: 'up', tag: 'weak',
              d: 'narrow spread up-bar, low volume' },
            { x: 160, t: 'Test', v: 26, hi: 90, lo: 168, close: 96, cd: 'up', tag: 'strong',
              d: 'marked down, closes high, low volume' },
            { x: 320, t: 'Up-thrust', v: 74, hi: 74, lo: 150, close: 144, cd: 'down', tag: 'weak',
              d: 'pushed up, closes near low, high volume' },
            { x: 480, t: 'Stopping volume', v: 86, hi: 84, lo: 170, close: 92, cd: 'up', tag: 'strong',
              d: 'down-bar, closes on high, very high volume' },
          ].map((s) => (
            <g transform={`translate(${s.x + 60},0)`}>
              <text x="0" y="16" class="cap mid">{s.t}</text>
              <line x1="0" y1={s.hi} x2="0" y2={s.lo} class="bar" />
              <line x1="0" y1={s.close} x2="18" y2={s.close} class={`bar ${s.cd}`} />
              <line x1="-46" y1="200" x2="46" y2="200" class="axis" />
              <rect x="-7" y={200 - s.v} width="14" height={s.v} class={`vol ${s.tag}`} />
              <text x="0" y="228" class={`lbl sm mid ${s.tag}`}>{s.tag === 'strong' ? 'STRENGTH' : 'WEAKNESS'}</text>
              <text x="0" y="252" class="lbl xs mid">{s.d.split(',')[0]},</text>
              <text x="0" y="268" class="lbl xs mid">{s.d.split(',').slice(1).join(',').trim()}</text>
            </g>
          ))}
        </g>
      </svg>
    )}

    {name === 'effort-result' && (
      <svg viewBox="0 0 640 260" role="img" aria-label="Effort versus result: high volume that moves price, versus high volume that does not">
        <g class="ink">
          <g transform="translate(20,0)">
            <text x="120" y="16" class="cap mid">EFFORT — AND A RESULT</text>
            <text x="-6" y="70" class="cap">PRICE</text>
            {[0, 1, 2, 3, 4].map((i) => (
              <line x1={40 + i * 40} y1={110 - i * 18} x2={40 + i * 40} y2={136 - i * 18} class="bar" />
            ))}
            <text x="-6" y="196" class="cap">VOL</text>
            <line x1="0" y1="200" x2="240" y2="200" class="axis" />
            {[20, 28, 36, 44, 52].map((h, i) => (
              <rect x={33 + i * 40} y={200 - h} width="14" height={h} class="vol strong" />
            ))}
            <text x="120" y="232" class="lbl sm mid strong">Volume rises, price travels.</text>
            <text x="120" y="250" class="lbl xs mid">The move is genuine.</text>
          </g>
          <line x1="320" y1="30" x2="320" y2="212" class="divider" />
          <g transform="translate(360,0)">
            <text x="120" y="16" class="cap mid">EFFORT — AND NO RESULT</text>
            {[0, 1, 2, 3, 4].map((i) => (
              <line x1={40 + i * 40} y1={104 + (i % 2) * 5} x2={40 + i * 40} y2={130 + (i % 2) * 5} class="bar" />
            ))}
            <line x1="0" y1="200" x2="240" y2="200" class="axis" />
            {[30, 40, 46, 50, 55].map((h, i) => (
              <rect x={33 + i * 40} y={200 - h} width="14" height={h} class="vol weak" />
            ))}
            <text x="120" y="232" class="lbl sm mid weak">Volume rises, price stalls.</text>
            <text x="120" y="250" class="lbl xs mid">Someone is absorbing it.</text>
          </g>
        </g>
      </svg>
    )}

    {name === 'cycle' && (
      <svg viewBox="0 0 640 260" role="img" aria-label="Market cycle: accumulation, mark-up, distribution and mark-down">
        <g class="ink">
          <path d="M20 190 C 70 190, 110 186, 150 188 C 230 188, 280 90, 340 66 C 390 52, 430 66, 470 62 C 530 62, 570 150, 620 194"
                class="curve" />
          <g class="zone">
            <rect x="20" y="40" width="130" height="170" class="band strongband" />
            <rect x="330" y="40" width="140" height="170" class="band weakband" />
          </g>
          <text x="85" y="32" class="cap mid strong">ACCUMULATION</text>
          <text x="85" y="228" class="lbl xs mid">Quiet buying, bad news,</text>
          <text x="85" y="243" class="lbl xs mid">weak holders sell out</text>

          <text x="245" y="120" class="cap mid">MARK-UP</text>
          <text x="245" y="140" class="lbl xs mid">price travels</text>

          <text x="400" y="32" class="cap mid weak">DISTRIBUTION</text>
          <text x="400" y="228" class="lbl xs mid">Quiet selling, good news,</text>
          <text x="400" y="243" class="lbl xs mid">the public buys in</text>

          <text x="556" y="120" class="cap mid">MARK-DOWN</text>
          <text x="556" y="140" class="lbl xs mid">price falls</text>
        </g>
      </svg>
    )}
  </div>
  <figcaption>{TITLES[name]} <span>· added for this edition, not from the book</span></figcaption>
</figure>

<style>
  .dgm { margin: 2.2rem 0; }
  .dgm__box {
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper-2);
    padding: 1.2rem 1.1rem .9rem;
  }
  .dgm svg { display: block; width: 100%; height: auto; overflow: visible; }
  .dgm figcaption {
    font-family: var(--sans); font-size: .76rem; color: var(--ink-soft); margin-top: .6rem;
  }
  .dgm figcaption span { color: var(--ink-faint); }

  .bar { stroke: var(--ink); stroke-width: 3; stroke-linecap: square; }
  .bar.up { stroke: var(--strength); }
  .bar.down { stroke: var(--weakness); }
  .tick { stroke: var(--ink-faint); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .brace { fill: none; stroke: var(--ink-faint); stroke-width: 1.5; }
  .axis { stroke: var(--rule); stroke-width: 1.5; }
  .divider { stroke: var(--rule); stroke-width: 1; }
  .curve { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-linecap: round; }
  .vol { fill: var(--ink-faint); }
  .vol.strong { fill: var(--strength); }
  .vol.weak { fill: var(--weakness); }
  .band { rx: 8; }
  .strongband { fill: var(--strength); opacity: .1; }
  .weakband { fill: var(--weakness); opacity: .1; }

  text { font-family: var(--sans); fill: var(--ink); }
  .cap { font-size: 11px; font-weight: 700; letter-spacing: .08em; fill: var(--ink-faint); }
  .lbl { font-size: 13px; }
  .lbl.sm { font-size: 11.5px; }
  .lbl.xs { font-size: 10.5px; fill: var(--ink-soft); }
  .mid { text-anchor: middle; }
  .strong { fill: var(--strength); }
  .weak { fill: var(--weakness); }
  .cap.strong { fill: var(--strength); }
  .cap.weak { fill: var(--weakness); }
</style>
