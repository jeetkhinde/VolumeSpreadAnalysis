---
import { bySection, toc } from '../lib/book';
import { href, t, type Lang } from '../lib/i18n';

const { current, lang = 'en' } = Astro.props as { current?: string; lang?: Lang };
const sections = bySection(await toc(lang));
---

<nav class="sidebar" id="sidebar" aria-label={t(lang, 'toc')}>
  <a class="sidebar__brand" href={href(lang, '/')}>
    <div class="sidebar__title">{t(lang, 'bookTitle')}</div>
    <div class="sidebar__author">{t(lang, 'author')}</div>
  </a>

  {sections.map((s) => (
    <div>
      <div class="sidebar__section">{s.name}</div>
      {s.items.map((ch) => (
        <a
          class="sidebar__link"
          href={href(lang, `/read/${ch.slug}/`)}
          aria-current={ch.slug === current ? 'page' : undefined}
        >
          <span class="sidebar__num">{ch.order}</span>
          <span>{ch.title}</span>
        </a>
      ))}
    </div>
  ))}

  <div class="sidebar__section">{t(lang, 'reference')}</div>
  <a class="sidebar__link" href={href(lang, '/key-points/')} aria-current={current === 'key-points' ? 'page' : undefined}>
    <span class="sidebar__num">★</span><span>{t(lang, 'keyPoints')}</span>
  </a>
  <a class="sidebar__link" href={href(lang, '/glossary/')} aria-current={current === 'glossary' ? 'page' : undefined}>
    <span class="sidebar__num">§</span><span>{t(lang, 'glossary')}</span>
  </a>
</nav>
<div class="scrim" id="scrim"></div>
