---
import Base from '../layouts/Base.astro';
import manifest from '../data/manifest.json';
import { href, LANG_META, t } from '../lib/i18n';

const lang = 'en';
const first = manifest[0];
// One 404 serves the whole site, so it offers a way back into both editions.
---

<Base lang={lang} title={t(lang, 'notFound')} crumb={t(lang, 'notFound')} altPath="/">
  <div class="home">
    <div class="eyebrow">404</div>
    <h1>{t(lang, 'notFoundTitle')}</h1>
    <p class="home__sub">
      The book has {manifest.length} chapters and a glossary — try the contents,
      or press <kbd>/</kbd> to search the text.
    </p>
    <div style="display:flex;gap:.75rem;flex-wrap:wrap">
      <a class="cta" href={href('en', '/')}>{t('en', 'contents')}</a>
      <a class="cta cta--ghost" href={href('en', `/read/${first.slug}/`)}>{t('en', 'startReading')}</a>
      <a class="cta cta--ghost" href={href('en', '/glossary/')}>{t('en', 'glossary')}</a>
    </div>

    <p class="home__sub" lang={LANG_META.pa.tag} style="margin-top:2.2rem">{t('pa', 'notFoundTitle')}</p>
    <div style="display:flex;gap:.75rem;flex-wrap:wrap" lang={LANG_META.pa.tag}>
      <a class="cta cta--ghost" href={href('pa', '/')}>{t('pa', 'contents')}</a>
      <a class="cta cta--ghost" href={href('pa', `/read/${first.slug}/`)}>{t('pa', 'startReading')}</a>
      <a class="cta cta--ghost" href={href('pa', '/glossary/')}>{t('pa', 'glossary')}</a>
    </div>
  </div>
</Base>
