---
import Base from '../layouts/Base.astro';
import glossary from '../data/glossary.json';

const entries = [...glossary].sort((a, b) =>
  a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));

const letters = [...new Set(entries.map((e) => e.term.trim()[0].toUpperCase()))];
let seen = '';
const rows = entries.map((e) => {
  const L = e.term.trim()[0].toUpperCase();
  const head = L !== seen ? L : null;
  seen = L;
  return { ...e, head };
});
---

<Base title="Glossary · Master the Markets" current="glossary" crumb="Reference">
  <div class="gl">
    <div class="eyebrow">Reference</div>
    <h1>Glossary of Terms</h1>
    <p style="color:var(--ink-soft);margin:.5rem 0 0">
      All {entries.length} entries from the back of the book, with their illustrations.
    </p>

    <input
      class="gl__search"
      id="glfilter"
      type="search"
      placeholder="Filter terms…"
      autocomplete="off"
      spellcheck="false"
    />

    <div class="gl__az">
      {letters.map((L) => <a href={`#letter-${L}`}>{L}</a>)}
    </div>

    <div id="gllist">
      {rows.map((e) => (
        <>
          {e.head && <div class="gl__letter" id={`letter-${e.head}`}>{e.head}</div>}
          <div class="gl__entry" id={e.slug} data-term={e.term.toLowerCase()}>
            <h2 class="gl__term">{e.term}</h2>
            {e.blocks.map((b: any) =>
              b.t === 'figure' ? (
                <figure class="fig">
                  <img src={b.src} width={b.w} height={b.h} loading="lazy" decoding="async"
                       alt={b.caption ?? `Chart illustrating ${e.term}`} />
                  {(b.label || b.caption) && (
                    <figcaption>
                      {b.label && <b>{b.label}</b>}{b.label && b.caption ? ' — ' : ''}{b.caption}
                    </figcaption>
                  )}
                </figure>
              ) : b.t === 'bullet' ? (
                <ul style="margin:.2rem 0"><li>{b.text}</li></ul>
              ) : (
                <p>{b.text}</p>
              )
            )}
          </div>
        </>
      ))}
    </div>
    <div class="gl__empty" id="glempty" hidden>No terms match that filter.</div>
  </div>

  <script is:inline>
    const filter = document.getElementById('glfilter');
    const list = document.getElementById('gllist');
    const empty = document.getElementById('glempty');
    filter?.addEventListener('input', () => {
      const q = filter.value.trim().toLowerCase();
      let shown = 0;
      list.querySelectorAll('.gl__entry').forEach((el) => {
        const hit = !q || el.dataset.term.includes(q) || el.textContent.toLowerCase().includes(q);
        el.hidden = !hit;
        if (hit) shown++;
      });
      list.querySelectorAll('.gl__letter').forEach((el) => { el.hidden = !!q; });
      empty.hidden = shown > 0;
    });
  </script>
</Base>
