---
import Base from '../layouts/Base.astro';
import GlossaryBody from '../components/GlossaryBody.astro';
import { pageTitle, t } from '../lib/i18n';
const lang = 'en';
---

<Base lang={lang} title={pageTitle(lang, t(lang, 'glossary'))} current="glossary" crumb={t(lang, 'reference')} altPath="/glossary/">
  <GlossaryBody lang={lang} />
</Base>
