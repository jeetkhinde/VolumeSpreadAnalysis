---
import Base from '../layouts/Base.astro';
import Diagram from '../components/Diagram.astro';
import manifest from '../data/manifest.json';
import annotations from '../data/annotations.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const notes = annotations as Record<string, any>;

const sections: { name: string; items: typeof manifest }[] = [];
for (const ch of manifest) {
  let s = sections.find((x) => x.name === ch.section);
  if (!s) sections.push((s = { name: ch.section, items: [] }));
  s.items.push(ch);
}
const total = Object.values(notes).reduce((n, v: any) => n + v.remember.length, 0);
---

<Base
  title="Key points · Master the Markets"
  current="key-points"
  crumb="Key points"
  description="Every takeaway from Master the Markets on one page."
>
  <div class="kp">
    <div class="eyebrow">Things to remember</div>
    <h1>Key points</h1>
    <p style="color:var(--ink-soft);margin:.6rem 0 0;font-size:1.08rem">
      All {total} takeaways from the {manifest.length} chapters, on one page.
      Each links back to the chapter it came from.
    </p>

    <Diagram name="bar-anatomy" />
    <Diagram name="signals" />
    <Diagram name="weakness-signatures" />
    <Diagram name="close-position" />
    <Diagram name="cycle" />

    {sections.map((s) => (
      <section>
        <div class="kp__sec">{s.name}</div>
        {s.items.map((ch) => notes[ch.slug] && (
          <div class="kp__ch">
            <h2 class="kp__t">
              <span class="kp__n">{ch.order}</span>
              <a href={`${base}/read/${ch.slug}/`}>{ch.title}</a>
            </h2>
            <ul>
              {notes[ch.slug].remember.map((r: string) => <li>{r}</li>)}
            </ul>
          </div>
        ))}
      </section>
    ))}

    <p style="margin-top:3.5rem;font-family:var(--sans);font-size:.78rem;color:var(--ink-faint);line-height:1.6">
      These summaries and diagrams were written for this edition to make the
      method easier to follow. They are not Tom Williams' words — his text is
      reproduced in full in the chapters themselves.
    </p>
  </div>
</Base>
