---
import Base from '../layouts/Base.astro';
import KeyPointsBody from '../components/KeyPointsBody.astro';
import { pageTitle, t } from '../lib/i18n';
const lang = 'en';
---

<Base
  lang={lang}
  title={pageTitle(lang, t(lang, 'keyPointsTitle'))}
  current="key-points"
  crumb={t(lang, 'keyPointsTitle')}
  description="Every takeaway from Master the Markets on one page."
  altPath="/key-points/"
>
  <KeyPointsBody lang={lang} />
</Base>
