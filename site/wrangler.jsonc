{
  // Used when the Workers Builds "Root directory" is set to `site`.
  // The repo-root wrangler.jsonc is used when it is `/`. Keep them in sync.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vsa",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
